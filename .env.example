# Copy this file to .env. Never commit real credentials.

# Agent / generation model: ollama or openai
LLM_BACKEND=openai
LLM_PROVIDER=dashscope
AGENT_LLM_BACKEND=openai
AGENT_LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen-plus
API_TIMEOUT=30
API_MAX_RETRIES=1

# Optional per-node model overrides
AGENT_INTENT_MODEL=
AGENT_PLANNER_MODEL=
AGENT_REFLECTION_MODEL=
AGENT_SYNTHESIZE_MODEL=

# Embedding / rerank
EMBEDDING_BACKEND=api
EMBEDDING_API_PROVIDER=dashscope
EMBEDDING_API_TYPE=openai
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_BATCH_SIZE=10
RERANK_BACKEND=api
DASHSCOPE_RERANK_API_BASE=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
DASHSCOPE_RERANK_MODEL=qwen3-rerank
RERANK_TOP_N=10

# Optional visual retrieval
ENABLE_VISUAL_RETRIEVAL=false
VISUAL_EMBEDDING_BACKEND=api
VISUAL_EMBEDDING_API_KEY=
VISUAL_EMBEDDING_API_MODEL=
VISUAL_EMBEDDING_API_TIMEOUT=60

# Bocha web-search MCP fallback
ENABLE_BOCHA_SEARCH=true
BOCHA_API_KEY=
BOCHA_MCP_COMMAND=uv
BOCHA_MCP_TOOL=bocha_web_search
BOCHA_MCP_TIMEOUT=60

# Request-scoped execution limits
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_RAG_CALLS=5
AGENT_MAX_WEB_SEARCH_CALLS=2
AGENT_MAX_TOOL_SECONDS=120
AGENT_MAX_RETRIEVAL_RETRIES=2
AGENT_MAX_GROUNDING_RETRIES=1

# Optional LangSmith export. Local execution_trace works without it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=automotive-agentic-rag
